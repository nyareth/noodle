{
  "name": "noodle",
  "version": "1.0.0",
  "private": true,
  "description": "Noodle - practice quizzes with a Moodle-style quiz attempt interface",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d db",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/migrate.ts --reset && tsx scripts/seed.ts",
    "test": "npm run test:unit && npm run test:api",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:api": "node --test tests/api.test.mjs"
  },
  "dependencies": {
    "@next/env": "^16.4.3",
    "bcryptjs": "^3.0.2",
    "katex": "^0.16.0",
    "next": "^16.4.3",
    "pg": "^8.13.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "uploadthing": "^7.7.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  }
}
