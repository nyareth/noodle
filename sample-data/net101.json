    {
      "external_id": "net-010",
      "text": "Consider the following statements about TCP:\n1. It is connection-oriented.\n2. It guarantees ordered delivery of data.\n3. It has no flow control.\n\nWhich statements are true?",
      "type": "single_choice",
      "options": [
        { "label": "A", "text": "1 only" },
        { "label": "B", "text": "1 and 2 only" },
        { "label": "C", "text": "2 and 3 only" },
        { "label": "D", "text": "1, 2 and 3" }
      ],
      "correct_answers": ["B"],
      "explanation": "TCP provides flow control through the receive window, so statement 3 is false.",
      "image": null
