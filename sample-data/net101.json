      "options": [
        { "label": "A", "text": "Network" },
        { "label": "B", "text": "Transport" },
        { "label": "C", "text": "Session" },
        { "label": "D", "text": "Data link" }
      ],
      "correct_answers": ["B"],
      "explanation": null,
      "image": null
    },
    {
      "external_id": "net-005",
      "text": "A subnet uses the mask 255.255.255.192 ($/26$).\n\nHow many usable host addresses does each subnet provide?",
      "type": "single_choice",
      "options": [
        { "label": "A", "text": "30" },
        { "label": "B", "text": "62" },
        { "label": "C", "text": "64" },
        { "label": "D", "text": "126" }
      ],
      "correct_answers": ["B"],
      "explanation": "A /26 leaves 6 host bits, so the number of usable hosts is $2^{6} - 2 = 62$.",
      "image": null
    },
    {
