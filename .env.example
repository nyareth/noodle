# ---- Database (required) ----
DATABASE_URL=postgres://quiz:quiz@localhost:5432/quiz

# ---- Site ----
SITE_NAME="Campus Quiz Practice"
APP_TIMEZONE=Asia/Kuala_Lumpur
# Answer labels shown next to options: abc (a. b. c. - Moodle default), ABCD, 123, none
ANSWER_NUMBERING=abc

# ---- Accounts ----
# Let students create their own account on /register
ALLOW_REGISTRATION=true
# Optional: only accept these e-mail domains for self-registration (comma separated)
ALLOWED_EMAIL_DOMAIN=
SESSION_DAYS=14
BCRYPT_COST=12
# Force the Secure flag on the session cookie. Leave empty to auto-detect (https => secure).
COOKIE_SECURE=
# Extra origins allowed to call the API (only needed behind unusual proxies). Comma separated.
TRUSTED_ORIGINS=

# ---- First admin (used by `npm run db:seed`) ----
ADMIN_EMAIL=admin@campus.test
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Quiz Administrator
SEED_DEMO_DATA=true

# ---- Quiz rules ----
MAX_QUESTIONS_PER_ATTEMPT=100
# Extra seconds after the deadline during which the final submit is still accepted
DEADLINE_GRACE_SECONDS=10

# ---- Question images ----
MAX_IMAGE_BYTES=5242880
STORAGE_DRIVER=local            # local | s3
LOCAL_UPLOAD_DIR=./uploads
# S3-compatible storage (AWS S3, Cloudflare R2, MinIO, ...) when STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
