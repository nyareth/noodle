# =====================================================================================
# Noodle configuration.   cp .env.example .env
# Read by docker compose AND by `npm run dev` / `npm start`. Only the database is required.
# =====================================================================================

# ---- PostgreSQL (the docker-compose "db" service is created from these) ----
POSTGRES_USER=noodle
# Use URL-safe characters (letters, digits, - _ .): the password is placed inside DATABASE_URL.
POSTGRES_PASSWORD=noodle
POSTGRES_DB=noodle
# On your machine this is localhost; inside docker compose the app automatically uses the "db" service.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ---- Docker app container ----
# Host port that serves the website.
APP_PORT=3000
# Create the admin (and the demo student + sample subject) the first time the database is empty.
SEED_ON_START=true

# ---- Site ----
SITE_NAME=Noodle
APP_TIMEZONE=Asia/Kuala_Lumpur
# Answer labels: abc (Moodle default "a. b. c."), ABCD, 123, none
ANSWER_NUMBERING=abc

# ---- Accounts ----
# Let students create their own account on /register
ALLOW_REGISTRATION=true
# Optional: only accept these e-mail domains for self-registration (comma separated)
ALLOWED_EMAIL_DOMAIN=
SESSION_DAYS=14
BCRYPT_COST=12
# Force the Secure flag on the session cookie. Leave empty to auto-detect (https => secure).
COOKIE_SECURE=
# Extra origins allowed to call the API (only needed behind unusual proxies). Comma separated.
TRUSTED_ORIGINS=

# ---- First admin (used by the seed) ----
ADMIN_EMAIL=admin@campus.test
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Quiz Administrator
# Demo student + 12-question sample subject with a banner
SEED_DEMO_DATA=true

# ---- Quiz rules ----
MAX_QUESTIONS_PER_ATTEMPT=100
# Extra seconds after the deadline during which the final submit is still accepted
DEADLINE_GRACE_SECONDS=10

# ---- Images (question pictures and subject banners) ----
# UploadThing: dashboard > your app > API Keys > copy the UPLOADTHING_TOKEN value.
# Leave it empty to keep images on disk (LOCAL_UPLOAD_DIR) - fine for development.
UPLOADTHING_TOKEN=
# Optional: force "local" or "uploadthing". Default: uploadthing when a token is set, otherwise local.
STORAGE_DRIVER=
LOCAL_UPLOAD_DIR=./uploads
MAX_IMAGE_BYTES=5242880
